{
  "manifest_version": 3,
  "name": "IndiaMART Contact Buyer Auto-Click",
  "version": "1.1",
  "description": "Auto-clicks 'Contact Buyer Now' on IndiaMART leads matching your medicine name, country, and phone-availability filters, with a daily click cap. Detects new leads instantly via MutationObserver and keeps scanning even when the tab is backgrounded.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://seller.indiamart.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://seller.indiamart.com/bltxn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IndiaMART Auto-Click Settings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/*.js"
      ],
      "matches": [
        "https://seller.indiamart.com/*"
      ]
    }
  ]
}
